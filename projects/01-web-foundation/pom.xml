<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

<!-- 继承 Spring Boot 父 POM 的依赖版本管理和构建默认配置 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

<!-- 项目基本信息 -->
    <groupId>com.qiubai.lab</groupId>
    <artifactId>web-foundation</artifactId>
    <version>0.0.1-SNAPSHOT</version>

<!-- 项目构建时使用的JDK版本号 -->
    <properties>
        <java.version>17</java.version>
    </properties>

<!-- 项目依赖 -->
    <dependencies>

    <!-- Spring Boot Web 依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>


        <!-- 引入 Jakarta Validation API 及 Hibernate Validator 实现，用于校验请求参数。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MyBatis 与 Spring Boot 的整合；当前 Boot 3.5 使用兼容的 starter 3.0.x。 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <!-- 此依赖不在 Spring Boot 默认版本管理中，因此明确指定。 -->
            <version>3.0.5</version>
        </dependency>

        <!-- MySQL 的 JDBC 驱动，版本由 Spring Boot 父 POM 管理。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <!-- 通过 JDBC 接口使用驱动；运行时需要，不必直接依赖其类进行编译。 -->
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok 在编译时生成 getter/setter；版本由 Spring Boot 父 POM 管理。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <!-- 仅供编译等阶段使用，应用运行时不需要 Lombok。 -->
            <scope>provided</scope>
        </dependency>
    </dependencies>

<!-- 项目构建配置 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
